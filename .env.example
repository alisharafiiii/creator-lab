# این فایل را کپی کنید: npm run setup  (یک فایل .env می‌سازد)
# کلیدهای واقعی فقط در .env قرار می‌گیرند. .env در .gitignore است و هرگز commit نمی‌شود.
# Copy with npm run setup. Keep real keys in .env only — never commit it.

# groq (پلن رایگان دارد) یا fireworks — فقط کلید همان سرویسی که انتخاب می‌کنید لازم است.
TRANSCRIPTION_PROVIDER=groq
# https://console.apify.com/  → Settings → API & Integrations
APIFY_TOKEN=
# https://typesafe.ai/  (Jev — دسته‌بندی اسکریپت‌ها)
TYPESAFE_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://app.fireworks.ai/
FIREWORKS_API_KEY=
PORT=5190

# سقف سرعت درخواست‌ها. اگر حساب‌تان محدودیت کمتری دارد این‌ها را پایین بیاورید.
FIREWORKS_REQUESTS_PER_MINUTE=60
GROQ_REQUESTS_PER_MINUTE=20
